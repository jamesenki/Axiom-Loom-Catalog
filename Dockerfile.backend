# Dockerfile for Axiom Loom Catalog Backend
# Runs Node.js server with cloned repositories
# Build: 2025-10-20-v5 - Clone private profile repo with token

FROM node:18-alpine

# Install git for cloning repositories
RUN apk add --no-cache git

# Accept GitHub token as build argument for cloning private repos
ARG GITHUB_TOKEN

# Cache-busting argument to force git clone refresh
ARG CACHE_BUST=unknown

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (no PM2 needed)
RUN npm ci --only=production

# Copy server code
COPY src/server.js ./src/
COPY src/api/ ./src/api/
COPY src/services/ ./src/services/
COPY src/middleware/ ./src/middleware/
COPY src/utils/ ./src/utils/

# Copy startup script (no longer needed at runtime)
COPY scripts/clone-repositories.sh ./scripts/
RUN chmod +x ./scripts/clone-repositories.sh

# Create directory for cloned repositories
RUN mkdir -p /app/cloned-repositories

# Use CACHE_BUST to force re-cloning of repositories when content changes
RUN echo "Cache bust: $CACHE_BUST"

# Clone ALL repositories during Docker build
# This ensures all repos are baked into the image with their metadata
RUN cd /app/cloned-repositories && \
    if [ -n "$GITHUB_TOKEN" ]; then \
        echo "=== Cloning all repositories with GitHub token ===" && \
        for repo in \
            axiomloom-iot-platform \
            cloudtwin-simulation-platform-architecture \
            deploymaster-sdv-ota-platform \
            diagnostic-as-code-platform-architecture \
            fleet-digital-twin-platform-architecture \
            future-mobility-consumer-platform \
            future-mobility-enterprise-platform \
            future-mobility-utilities-platform \
            mobility-architecture-package-orchestrator \
            remote-diagnostic-assistance-platform-architecture \
            rentalFleets \
            sdv-architecture-orchestration \
            sovd-diagnostic-ecosystem-platform-architecture \
            vehicle-to-cloud-communications-architecture \
            velocityforge-sdv-platform-architecture \
            profile; do \
            echo "Cloning $repo..." && \
            git clone "https://$GITHUB_TOKEN@github.com/jamesenki/$repo.git" "$repo" 2>/dev/null || echo "⚠️  Failed to clone $repo"; \
        done && \
        echo "✅ Repository cloning complete" && \
        ls -l | grep "^d" | wc -l | xargs echo "Total repositories:"; \
    else \
        echo "⚠️  No GITHUB_TOKEN provided - cannot clone private repos"; \
    fi

# Copy repository metadata
COPY repository-metadata.json ./

# Set environment variable for blog articles path
# Profile repo is now guaranteed to exist at build time
ENV BLOG_ARTICLES_PATH=/app/cloned-repositories/profile/articles

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start server directly (all repos are pre-cloned at build time)
CMD ["node", "src/server.js"]
